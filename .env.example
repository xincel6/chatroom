# .env.example
CHAT_SERVER_PORT=3000
CHAT_HEARTBEAT_INTERVAL=30000
CHAT_HEARTBEAT_TIMEOUT=60000
CHAT_MAX_HISTORY=100
CHAT_DEFAULT_ROOM=lobby
CHAT_ENCRYPTION_KEY=  # 可选：32字节 hex 字符串

# === V3 新增：数据持久化配置 ===
# 数据存储目录
CHAT_DATA_DIR=./data

# JWT
CHAT_JWT_SECRET=your-secret-key-here-change-in-production
CHAT_TOKEN_EXPIRY=86400           # Token 有效期（秒），默认 24 小时

# bcrypt
CHAT_BCRYPT_ROUNDS=12             # 哈希迭代次数